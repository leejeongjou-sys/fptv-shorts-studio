# Firebase 웹 앱 설정 (Firebase 콘솔 → 프로젝트 설정 → 내 앱 → SDK 설정)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 컬렉션 이름 앞에 붙일 말 (Brand Studio와 같은 프로젝트를 쓸 때 겹치지 않게)
NEXT_PUBLIC_COLLECTION_PREFIX=fptv_

# 팀 비밀번호 (비워두면 잠금 없음)
SITE_PASSWORD=

# PC 예약 작업이 /api/queue 를 부를 때 쓰는 열쇠
QUEUE_TOKEN=
# Firebase 서비스 계정 JSON 한 줄 (프로젝트 설정 → 서비스 계정 → 새 비공개 키)
FIREBASE_SERVICE_ACCOUNT=
